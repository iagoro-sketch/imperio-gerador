{
  "name": "roteirizador",
  "main": "worker.js",
  "compatibility_date": "2026-09-10",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "KPI_STORE",
        "class_name": "KpiStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "kpi-shared-v1",
      "new_sqlite_classes": ["KpiStore"]
    }
  ]
}
